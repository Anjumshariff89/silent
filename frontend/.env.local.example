# Frontend settings (copy to .env.local). NEXT_PUBLIC_* values are shipped to the browser: only public values here.
# Never put the Supabase service-role key, the database password or CYPRUS1_PK in this file.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Supabase Auth (Project Settings -> API). Leave empty to use the local admin/API_KEY login instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
