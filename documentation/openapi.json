  "components": {
    "schemas": {
      "AnchorIn": {
        "properties": {
          "batch_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Batch Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "batch_id"
        ],
        "title": "AnchorIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HeartbeatIn": {
        "properties": {
          "agent_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "title": "Agent Id"
          },
          "hostname": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Hostname"
          },
          "agent_version": {
            "type": "string",
            "maxLength": 32,
            "title": "Agent Version",
            "default": "0.0.0"
          },
          "collector_mode": {
            "type": "string",
            "enum": [
              "windows",
              "simulator"
            ],
            "title": "Collector Mode",
            "default": "simulator"
          },
          "sent_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sent At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "agent_id",
          "hostname"
        ],
        "title": "HeartbeatIn"
      },
      "IngestIn": {
        "properties": {
          "agent_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "title": "Agent Id"
          },
          "event_id": {
            "type": "integer",
            "enum": [
              4624,
              4634,
              4672,
              4673
            ],
            "title": "Event Id"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "logon",
              "logoff",
              "special_privileges",
              "privileged_service"
            ],
            "title": "Event Type"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ],
            "title": "Severity",
            "default": "info"
          },
          "source_host": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Source Host"
          },
          "username": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Username"
          },
          "source_ip": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 45
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Ip"
          },
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message"
          },
          "event_time": {
            "type": "string",
            "format": "date-time",
            "title": "Event Time"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "agent_id",
          "event_id",
          "event_type",
          "source_host",
          "message",
          "event_time"
        ],
        "title": "IngestIn"
      },
      "LoginIn": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginIn"
      },
      "ProofVerifyIn": {
        "properties": {
          "batch_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Batch Id"
          },
          "seq_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Seq Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "batch_id"
        ],
        "title": "ProofVerifyIn"
      },
      "RangeIn": {
        "properties": {
          "from_seq": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "From Seq"
          },
          "to_seq": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "To Seq"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RangeIn"
      },
      "TamperIn": {
        "properties": {
          "seq_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Seq Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "modify",
              "delete",
              "reorder"
            ],
            "title": "Kind",
            "default": "modify"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "seq_id"
        ],
        "title": "TamperIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
